{
  "manifest_version": 3,
  "name": "Privacy-Preserving Vision Agent",
  "version": "1.0.0",
  "description": "Local OpenCV.js visual PII redactor with parallel Needle2 WASM agents, Playwright driver, multi-layer iframe access, and voice STT/TTS.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Privacy Vision Agent"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/playwright_driver.js",
        "content/content-script.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "weights/*",
        "orchestrator/*",
        "sidepanel/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
