{
  "manifest_version": 3,
  "name": "Gemma 4 Autonomous Browser Agent",
  "version": "2.0.0",
  "description": "100% offline browser automation agent powered by Gemma 4. Controls the browser and completes tasks via voice commands with audio feedback.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "webNavigation",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Gemma 4 Agent"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/playwright_driver.js",
        "content/content-script.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "orchestrator/*",
        "sidepanel/*",
        "content/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
