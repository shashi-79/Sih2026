{
  "manifest_version": 3,
  "name": "Gemma 4 Autonomous Browser Agent",
  "version": "2.1.0",
  "description": "Full browser control autonomous agent powered by Gemma 4. Controls tabs, navigation, clicks, inputs, and forms via voice commands with audio feedback.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "webNavigation",
    "sidePanel",
    "downloads",
    "bookmarks",
    "declarativeNetRequest",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Gemma 4 Agent"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/playwright_driver.js",
        "content/content-script.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "orchestrator/*",
        "sidepanel/*",
        "content/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
